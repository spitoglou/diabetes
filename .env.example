# .env.example - Example environment variables (no secrets)
# Copy this to .env and fill in your actual values

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=test_database_1
MONGO_COLLECTION=sandalphon1

# Patient & Model Configuration
OHIO_ID=559
WINDOW_STEPS=6
PREDICTION_HORIZON=6

# CGM Sample Interval (minutes between readings)
# Critical for prediction time calculation: horizon_steps * sample_interval = minutes ahead
# - Ohio dataset (Guardian sensor): 5 minutes
# - Simglucose (Dexcom sensor): 3 minutes
# Models trained on one interval cannot be used with different intervals!
SAMPLE_INTERVAL=5

# Server Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Streaming Interval Configuration
# Controls delay between CGM readings sent to server (in seconds)
# Ohio clients (client, synced-client): 300s realistic (Guardian 5-min), 20s for fast demo
# Simglucose client: 180s realistic (Dexcom 3-min), 20s for fast demo
INTERVAL=300
SIMGLUCOSE_INTERVAL=180

# Logging Configuration
LOG_LEVEL=INFO
LOG_JSON=False
LOG_FILE=

# Neptune ML Tracking (Optional - leave empty to disable)
NEPTUNE_PROJECT=your-username/your-project
NEPTUNE_API_TOKEN=your-neptune-api-token-here
